{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)",
        ".validate": "$code.length === 6",
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 24 && newData.child('subject').isString() && newData.child('subject').val().length <= 60)"
          }
        }
      }
    },
    "leaderboard": {
      "$date": {
        ".read": "auth != null",
        ".indexOn": ["min"],
        ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 24 && newData.child('min').isNumber() && newData.child('min').val() >= 0 && newData.child('min').val() <= 1440"
        }
      }
    }
  }
}
